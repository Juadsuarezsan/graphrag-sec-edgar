# --- LLM (optional: without a key the system runs in deterministic mode) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Embeddings: hashing (default, no downloads) | tfidf | voyage | local ---
EMBEDDER=hashing
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# --- Graph backend: memory (fixture + sample) | networkx (JSON on disk) | neo4j ---
GRAPH_BACKEND=memory
GRAPH_PATH=data/processed/graph.json
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- API security ---
CORS_ORIGINS=http://localhost:8000
RATE_LIMIT=30/minute
REQUEST_TIMEOUT_S=30
STALE_AFTER_DAYS=365

# --- SEC EDGAR download (a contact email in the User-Agent is mandatory) ---
SEC_USER_AGENT=graphrag-sec-edgar your.email@example.com

# --- Observability (LangSmith is wired only when the key is set) ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=graphrag-sec-edgar
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LOG_LEVEL=INFO
